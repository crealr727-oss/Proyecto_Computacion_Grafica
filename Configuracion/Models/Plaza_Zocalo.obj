mtllib Terreno_Zocalo.mtl
o Plaza_Zocalo
vn 0.0 1.0 0.0

# ================================================================
#  PLAZA DEL ZOCALO  -  Geometria fiel al plano arquitectonico
#
#  Sistema de coordenadas:
#    X negativo = Oeste   X positivo = Este
#    Z negativo = Norte   Z positivo = Sur
#    Plaza interior: -2.85 a +2.85 (5.70 x 5.70)
#    Con calles:     -3.60 a +3.60 (7.20 x 7.20)
#
#  UV = coordenada * 5.0  (5 repeticiones de textura por unidad)
#
#  Capas Y (para evitar z-fighting):
#    0.0000  Base piso interior pavimento
#    0.0010  Calles exteriores
#    0.0020  Banqueta perimetral
#    0.0030  Andadores principales (en cruz)
#    0.0040  Rotonda anillo exterior
#    0.0045  Rotonda piso interior (espacio kiosco)
#    0.0055  Tierra de laureles (AreaVerde)
#    0.0055  Piso Jardineras Formales (PisoBaldosa) - mismo nivel
#
#  ZONAS identificadas en el plano:
#  [TIERRA]   Laureles de la India / Areas de Arbolado Denso
#             -> textura_suelo_arbol.jpg
#  [PIEDRA]   Andadores Principales, Jardineras Formales, Rotonda
#             -> textura_patio_piedra.jpg
#  [BANQUETA] Orilla perimetral de la plaza
#             -> textura_banqueta.jpg
#  [CALLE]    Calles exteriores (asfalto)
#             -> textura_asfalto_calle.jpg
# ================================================================


# ================================================================
# ZONA 1: BASE INTERIOR GENERAL (Pavimento)
# Cubre toda la superficie interior de la plaza.
# Las capas superiores (tierra, jardineras) se dibujan encima.
# ================================================================
usemtl Pavimento
v -2.8500  0.0000 -2.8500
v -2.8500  0.0000  2.8500
v  2.8500  0.0000  2.8500
v  2.8500  0.0000 -2.8500
vt -14.25 -14.25
vt -14.25  14.25
vt  14.25  14.25
vt  14.25 -14.25
f 1/1/1 2/2/1 3/3/1 4/4/1


# ================================================================
# ZONA 2: CALLES EXTERIORES (Asfalto)
# Las 4 bandas de calle que rodean la manzana
# ================================================================
usemtl Calle

# Calle Norte  (x: -3.6 a 3.6 | z: -3.6 a -3.1)
v -3.6000  0.0010 -3.6000
v -3.6000  0.0010 -3.1000
v  3.6000  0.0010 -3.1000
v  3.6000  0.0010 -3.6000
vt -18.00 -18.00
vt -18.00 -15.50
vt  18.00 -15.50
vt  18.00 -18.00
f 5/5/1 6/6/1 7/7/1 8/8/1

# Calle Sur  (x: -3.6 a 3.6 | z: 3.1 a 3.6)
v -3.6000  0.0010  3.1000
v -3.6000  0.0010  3.6000
v  3.6000  0.0010  3.6000
v  3.6000  0.0010  3.1000
vt -18.00  15.50
vt -18.00  18.00
vt  18.00  18.00
vt  18.00  15.50
f 9/9/1 10/10/1 11/11/1 12/12/1

# Calle Oeste  (x: -3.6 a -3.1 | z: -3.1 a 3.1)
v -3.6000  0.0010 -3.1000
v -3.6000  0.0010  3.1000
v -3.1000  0.0010  3.1000
v -3.1000  0.0010 -3.1000
vt -18.00 -15.50
vt -18.00  15.50
vt -15.50  15.50
vt -15.50 -15.50
f 13/13/1 14/14/1 15/15/1 16/16/1

# Calle Este  (x: 3.1 a 3.6 | z: -3.1 a 3.1)
v  3.1000  0.0010 -3.1000
v  3.1000  0.0010  3.1000
v  3.6000  0.0010  3.1000
v  3.6000  0.0010 -3.1000
vt  15.50 -15.50
vt  15.50  15.50
vt  18.00  15.50
vt  18.00 -15.50
f 17/17/1 18/18/1 19/19/1 20/20/1


# ================================================================
# ZONA 3: BANQUETAS PERIMETRALES
# Orilla de la plaza (entre calle y el interior)
# 4 tiras + 4 esquinas
# ================================================================
usemtl Banqueta

# Banqueta Norte  (x: -3.1 a 3.1 | z: -3.1 a -2.85)
v -3.1000  0.0020 -3.1000
v -3.1000  0.0020 -2.8500
v  3.1000  0.0020 -2.8500
v  3.1000  0.0020 -3.1000
vt -15.50 -15.50
vt -15.50 -14.25
vt  15.50 -14.25
vt  15.50 -15.50
f 21/21/1 22/22/1 23/23/1 24/24/1

# Banqueta Sur  (x: -3.1 a 3.1 | z: 2.85 a 3.1)
v -3.1000  0.0020  2.8500
v -3.1000  0.0020  3.1000
v  3.1000  0.0020  3.1000
v  3.1000  0.0020  2.8500
vt -15.50  14.25
vt -15.50  15.50
vt  15.50  15.50
vt  15.50  14.25
f 25/25/1 26/26/1 27/27/1 28/28/1

# Banqueta Oeste  (x: -3.1 a -2.85 | z: -2.85 a 2.85)
v -3.1000  0.0020 -2.8500
v -3.1000  0.0020  2.8500
v -2.8500  0.0020  2.8500
v -2.8500  0.0020 -2.8500
vt -15.50 -14.25
vt -15.50  14.25
vt -14.25  14.25
vt -14.25 -14.25
f 29/29/1 30/30/1 31/31/1 32/32/1

# Banqueta Este  (x: 2.85 a 3.1 | z: -2.85 a 2.85)
v  2.8500  0.0020 -2.8500
v  2.8500  0.0020  2.8500
v  3.1000  0.0020  2.8500
v  3.1000  0.0020 -2.8500
vt  14.25 -14.25
vt  14.25  14.25
vt  15.50  14.25
vt  15.50 -14.25
f 33/33/1 34/34/1 35/35/1 36/36/1

# Esquina Banqueta NW  (x: -3.1 a -2.85 | z: -3.1 a -2.85)
v -3.1000  0.0020 -3.1000
v -3.1000  0.0020 -2.8500
v -2.8500  0.0020 -2.8500
v -2.8500  0.0020 -3.1000
vt -15.50 -15.50
vt -15.50 -14.25
vt -14.25 -14.25
vt -14.25 -15.50
f 37/37/1 38/38/1 39/39/1 40/40/1

# Esquina Banqueta NE  (x: 2.85 a 3.1 | z: -3.1 a -2.85)
v  2.8500  0.0020 -3.1000
v  2.8500  0.0020 -2.8500
v  3.1000  0.0020 -2.8500
v  3.1000  0.0020 -3.1000
vt  14.25 -15.50
vt  14.25 -14.25
vt  15.50 -14.25
vt  15.50 -15.50
f 41/41/1 42/42/1 43/43/1 44/44/1

# Esquina Banqueta SW  (x: -3.1 a -2.85 | z: 2.85 a 3.1)
v -3.1000  0.0020  2.8500
v -3.1000  0.0020  3.1000
v -2.8500  0.0020  3.1000
v -2.8500  0.0020  2.8500
vt -15.50  14.25
vt -15.50  15.50
vt -14.25  15.50
vt -14.25  14.25
f 45/45/1 46/46/1 47/47/1 48/48/1

# Esquina Banqueta SE  (x: 2.85 a 3.1 | z: 2.85 a 3.1)
v  2.8500  0.0020  2.8500
v  2.8500  0.0020  3.1000
v  3.1000  0.0020  3.1000
v  3.1000  0.0020  2.8500
vt  14.25  14.25
vt  14.25  15.50
vt  15.50  15.50
vt  15.50  14.25
f 49/49/1 50/50/1 51/51/1 52/52/1


# ================================================================
# ZONA 4: ANDADORES PRINCIPALES (en CRUZ)
# Son los caminos de piedra que dividen la plaza en 4 cuadrantes.
# Ancho total: 0.80 m (de -0.40 a +0.40)
# Van desde la banqueta hasta la rotonda central (~0.80 radio)
# Material: Pavimento (textura_patio_piedra.jpg)
# ================================================================
usemtl Pavimento

# Andador Norte  (x: -0.40 a 0.40 | z: -2.85 a -0.80)
v -0.4000  0.0030 -2.8500
v -0.4000  0.0030 -0.8000
v  0.4000  0.0030 -0.8000
v  0.4000  0.0030 -2.8500
vt -2.00 -14.25
vt -2.00  -4.00
vt  2.00  -4.00
vt  2.00 -14.25
f 53/53/1 54/54/1 55/55/1 56/56/1

# Andador Sur  (x: -0.40 a 0.40 | z: 0.80 a 2.85)
v -0.4000  0.0030  0.8000
v -0.4000  0.0030  2.8500
v  0.4000  0.0030  2.8500
v  0.4000  0.0030  0.8000
vt -2.00   4.00
vt -2.00  14.25
vt  2.00  14.25
vt  2.00   4.00
f 57/57/1 58/58/1 59/59/1 60/60/1

# Andador Oeste  (x: -2.85 a -0.80 | z: -0.40 a 0.40)
v -2.8500  0.0030 -0.4000
v -2.8500  0.0030  0.4000
v -0.8000  0.0030  0.4000
v -0.8000  0.0030 -0.4000
vt -14.25 -2.00
vt -14.25  2.00
vt  -4.00  2.00
vt  -4.00 -2.00
f 61/61/1 62/62/1 63/63/1 64/64/1

# Andador Este  (x: 0.80 a 2.85 | z: -0.40 a 0.40)
v  0.8000  0.0030 -0.4000
v  0.8000  0.0030  0.4000
v  2.8500  0.0030  0.4000
v  2.8500  0.0030 -0.4000
vt   4.00 -2.00
vt   4.00  2.00
vt  14.25  2.00
vt  14.25 -2.00
f 65/65/1 66/66/1 67/67/1 68/68/1


# ================================================================
# ZONA 5: ROTONDA CENTRAL (Kiosco Central)
# Anillo exterior = Banqueta (piedra de anden)
# Centro interior = Pavimento (reservado para el kiosco futuro)
# Radio exterior octagonal: 0.80  (0.80 * cos45 = 0.5657)
# Radio interior octagonal: 0.55  (0.55 * cos45 = 0.3889)
# ================================================================

# Anillo exterior de la rotonda (Banqueta)
usemtl Banqueta
v  0.8000  0.0040  0.0000
v  0.5657  0.0040  0.5657
v  0.0000  0.0040  0.8000
v -0.5657  0.0040  0.5657
v -0.8000  0.0040  0.0000
v -0.5657  0.0040 -0.5657
v  0.0000  0.0040 -0.8000
v  0.5657  0.0040 -0.5657
vt  4.00  0.00
vt  2.83  2.83
vt  0.00  4.00
vt -2.83  2.83
vt -4.00  0.00
vt -2.83 -2.83
vt  0.00 -4.00
vt  2.83 -2.83
f 69/69/1 70/70/1 71/71/1 72/72/1 73/73/1 74/74/1 75/75/1 76/76/1

# Piso interior de la rotonda (Pavimento - reservado para el kiosco)
usemtl Pavimento
v  0.5500  0.0045  0.0000
v  0.3889  0.0045  0.3889
v  0.0000  0.0045  0.5500
v -0.3889  0.0045  0.3889
v -0.5500  0.0045  0.0000
v -0.3889  0.0045 -0.3889
v  0.0000  0.0045 -0.5500
v  0.3889  0.0045 -0.3889
vt  2.75  0.00
vt  1.94  1.94
vt  0.00  2.75
vt -1.94  1.94
vt -2.75  0.00
vt -1.94 -1.94
vt  0.00 -2.75
vt  1.94 -1.94
f 77/77/1 78/78/1 79/79/1 80/80/1 81/81/1 82/82/1 83/83/1 84/84/1


# ================================================================
# ZONA 6: AREAS DE TIERRA (Laureles / Arbolado Denso)
# Estas son las zonas VERDES redondeadas del plano donde van
# los arboles. Textura: textura_suelo_arbol.jpg
#
# Cada cuadrante (NW, NE, SW, SE) se divide en:
#   - Bloque de tierra SUPERIOR/EXTERIOR (arbolado principal)
#   - Bloque de tierra LATERAL (junto al andador)
#   - Franja de tierra ESTRECHA (entre andador y jardinera)
#
# Cuadrante NW: x[-2.85,-0.40]  z[-2.85,-0.40]
# Cuadrante NE: x[+0.40,+2.85]  z[-2.85,-0.40]
# Cuadrante SW: x[-2.85,-0.40]  z[+0.40,+2.85]
# Cuadrante SE: x[+0.40,+2.85]  z[+0.40,+2.85]
#
# Dentro de cada cuadrante:
#   Jardinera Formal (piso piedra): x[jardinera_range], z[jardinera_range]
#   Resto: tierra (suelo_arbol)
#
# Jardinera NW: x[-2.05,-0.65]  z[-1.50,-0.50]
# Jardinera NE: x[+0.65,+2.05]  z[-1.50,-0.50]
# Jardinera SW: x[-2.05,-0.65]  z[+0.50,+1.50]
# Jardinera SE: x[+0.65,+2.05]  z[+0.50,+1.50]
# ================================================================
usemtl AreaVerde

# ─── CUADRANTE NW ─────────────────────────────────────────────────
# Tierra NORTE-NW: x[-2.85,-0.40]  z[-2.85,-1.50]
# (arbolado denso de la parte alta del cuadrante)
v -2.8500  0.0055 -2.8500
v -2.8500  0.0055 -1.5000
v -0.4000  0.0055 -1.5000
v -0.4000  0.0055 -2.8500
vt -14.25 -14.25
vt -14.25  -7.50
vt  -2.00  -7.50
vt  -2.00 -14.25
f 85/85/1 86/86/1 87/87/1 88/88/1

# Tierra OESTE-NW: x[-2.85,-2.05]  z[-1.50,-0.40]
# (Laureles de la India en el lado oeste del cuadrante)
v -2.8500  0.0055 -1.5000
v -2.8500  0.0055 -0.4000
v -2.0500  0.0055 -0.4000
v -2.0500  0.0055 -1.5000
vt -14.25  -7.50
vt -14.25  -2.00
vt -10.25  -2.00
vt -10.25  -7.50
f 89/89/1 90/90/1 91/91/1 92/92/1

# Tierra FRANJA ESTE-NW: x[-0.65,-0.40]  z[-1.50,-0.40]
# (franja estrecha entre jardinera y andador NS)
v -0.6500  0.0055 -1.5000
v -0.6500  0.0055 -0.4000
v -0.4000  0.0055 -0.4000
v -0.4000  0.0055 -1.5000
vt  -3.25  -7.50
vt  -3.25  -2.00
vt  -2.00  -2.00
vt  -2.00  -7.50
f 93/93/1 94/94/1 95/95/1 96/96/1

# ─── CUADRANTE NE ─────────────────────────────────────────────────
# Tierra NORTE-NE: x[+0.40,+2.85]  z[-2.85,-1.50]
v  0.4000  0.0055 -2.8500
v  0.4000  0.0055 -1.5000
v  2.8500  0.0055 -1.5000
v  2.8500  0.0055 -2.8500
vt   2.00 -14.25
vt   2.00  -7.50
vt  14.25  -7.50
vt  14.25 -14.25
f 97/97/1 98/98/1 99/99/1 100/100/1

# Tierra ESTE-NE: x[+2.05,+2.85]  z[-1.50,-0.40]
v  2.0500  0.0055 -1.5000
v  2.0500  0.0055 -0.4000
v  2.8500  0.0055 -0.4000
v  2.8500  0.0055 -1.5000
vt  10.25  -7.50
vt  10.25  -2.00
vt  14.25  -2.00
vt  14.25  -7.50
f 101/101/1 102/102/1 103/103/1 104/104/1

# Tierra FRANJA OESTE-NE: x[+0.40,+0.65]  z[-1.50,-0.40]
v  0.4000  0.0055 -1.5000
v  0.4000  0.0055 -0.4000
v  0.6500  0.0055 -0.4000
v  0.6500  0.0055 -1.5000
vt   2.00  -7.50
vt   2.00  -2.00
vt   3.25  -2.00
vt   3.25  -7.50
f 105/105/1 106/106/1 107/107/1 108/108/1

# ─── CUADRANTE SW ─────────────────────────────────────────────────
# Tierra SUR-SW: x[-2.85,-0.40]  z[+1.50,+2.85]
# (Laureles de la India - parte baja del cuadrante)
v -2.8500  0.0055  1.5000
v -2.8500  0.0055  2.8500
v -0.4000  0.0055  2.8500
v -0.4000  0.0055  1.5000
vt -14.25   7.50
vt -14.25  14.25
vt  -2.00  14.25
vt  -2.00   7.50
f 109/109/1 110/110/1 111/111/1 112/112/1

# Tierra OESTE-SW: x[-2.85,-2.05]  z[+0.40,+1.50]
v -2.8500  0.0055  0.4000
v -2.8500  0.0055  1.5000
v -2.0500  0.0055  1.5000
v -2.0500  0.0055  0.4000
vt -14.25   2.00
vt -14.25   7.50
vt -10.25   7.50
vt -10.25   2.00
f 113/113/1 114/114/1 115/115/1 116/116/1

# Tierra FRANJA ESTE-SW: x[-0.65,-0.40]  z[+0.40,+1.50]
v -0.6500  0.0055  0.4000
v -0.6500  0.0055  1.5000
v -0.4000  0.0055  1.5000
v -0.4000  0.0055  0.4000
vt  -3.25   2.00
vt  -3.25   7.50
vt  -2.00   7.50
vt  -2.00   2.00
f 117/117/1 118/118/1 119/119/1 120/120/1

# ─── CUADRANTE SE ─────────────────────────────────────────────────
# Tierra SUR-SE: x[+0.40,+2.85]  z[+1.50,+2.85]
# (Areas de Laureles - Arbolado Denso)
v  0.4000  0.0055  1.5000
v  0.4000  0.0055  2.8500
v  2.8500  0.0055  2.8500
v  2.8500  0.0055  1.5000
vt   2.00   7.50
vt   2.00  14.25
vt  14.25  14.25
vt  14.25   7.50
f 121/121/1 122/122/1 123/123/1 124/124/1

# Tierra ESTE-SE: x[+2.05,+2.85]  z[+0.40,+1.50]
v  2.0500  0.0055  0.4000
v  2.0500  0.0055  1.5000
v  2.8500  0.0055  1.5000
v  2.8500  0.0055  0.4000
vt  10.25   2.00
vt  10.25   7.50
vt  14.25   7.50
vt  14.25   2.00
f 125/125/1 126/126/1 127/127/1 128/128/1

# Tierra FRANJA OESTE-SE: x[+0.40,+0.65]  z[+0.40,+1.50]
v  0.4000  0.0055  0.4000
v  0.4000  0.0055  1.5000
v  0.6500  0.0055  1.5000
v  0.6500  0.0055  0.4000
vt   2.00   2.00
vt   2.00   7.50
vt   3.25   7.50
vt   3.25   2.00
f 129/129/1 130/130/1 131/131/1 132/132/1


# ================================================================
# ZONA 7: JARDINERAS FORMALES (Piso de Zocalo)
# Los rectangulos blancos/claros del plano entre los arboles.
# Son la superficie pavimentada de las jardineras - piso de piedra.
# Material: PisoBaldosa (textura_patio_piedra.jpg)
# Una jardinera por cuadrante, en la zona interior de cada uno.
# ================================================================
usemtl PisoBaldosa

# Jardinera Formal NW: x[-2.05,-0.65]  z[-1.50,-0.50]
# (cuadrante noroeste - zona blanca del plano)
v -2.0500  0.0055 -1.5000
v -2.0500  0.0055 -0.5000
v -0.6500  0.0055 -0.5000
v -0.6500  0.0055 -1.5000
vt -10.25  -7.50
vt -10.25  -2.50
vt  -3.25  -2.50
vt  -3.25  -7.50
f 133/133/1 134/134/1 135/135/1 136/136/1

# Jardinera Formal NE: x[+0.65,+2.05]  z[-1.50,-0.50]
# (cuadrante noreste - "Jardineras" del plano)
v  0.6500  0.0055 -1.5000
v  0.6500  0.0055 -0.5000
v  2.0500  0.0055 -0.5000
v  2.0500  0.0055 -1.5000
vt   3.25  -7.50
vt   3.25  -2.50
vt  10.25  -2.50
vt  10.25  -7.50
f 137/137/1 138/138/1 139/139/1 140/140/1

# Jardinera Formal SW: x[-2.05,-0.65]  z[+0.50,+1.50]
# (cuadrante suroeste - "Jardineras Formales" del plano)
v -2.0500  0.0055  0.5000
v -2.0500  0.0055  1.5000
v -0.6500  0.0055  1.5000
v -0.6500  0.0055  0.5000
vt -10.25   2.50
vt -10.25   7.50
vt  -3.25   7.50
vt  -3.25   2.50
f 141/141/1 142/142/1 143/143/1 144/144/1

# Jardinera Formal SE: x[+0.65,+2.05]  z[+0.50,+1.50]
# (cuadrante sureste - "Jardineras Formales" del plano)
v  0.6500  0.0055  0.5000
v  0.6500  0.0055  1.5000
v  2.0500  0.0055  1.5000
v  2.0500  0.0055  0.5000
vt   3.25   2.50
vt   3.25   7.50
vt  10.25   7.50
vt  10.25   2.50
f 145/145/1 146/146/1 147/147/1 148/148/1
